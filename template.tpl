      klantId: 'aB3dEf7h',
      waitForUpdate: true,
      urlPassthrough: false,
      adsDataRedaction: false
    };
    mock('getCookieValues', function () {
      return ['{"v":2,"cats":{"necessary":true,"functional":false,"analytics":true,"marketing":true,"uncategorized":false},"ts":1717000000000}'];
    });
    runCode(mockData);
    assertApi('updateConsentState').wasCalledWith({
