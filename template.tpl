___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const JSON = require('JSON');
const log = require('logToConsole');
const gtagSet = require('gtagSet');
const setInWindow = require('setInWindow');

// The banner script always comes from our own host; the account ID is the only value
// you supply. It goes through encodeUriComponent, so a value containing '/' or '?'
// cannot escape the query string and point the injection somewhere else.
const bannerUrl = 'https://dashboard.ga4support.nl/api/cookie-banner/cb.js?klant=' + encodeUriComponent(data.klantId);

// Both of these have to be set before the consent default. They are off by default:
// passthrough changes the links on your own site, redaction changes your measurement.
gtagSet({
  url_passthrough: data.urlPassthrough === true,
  ads_data_redaction: data.adsDataRedaction === true
});

// Consent Mode v2 default: everything denied except security_storage.
const waitMs = data.waitForUpdate ? 500 : 0;
setDefaultConsentState({
  ad_storage: 'denied',
  analytics_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: waitMs
});

// Restore an earlier choice. The banner script writes {v:2, cats:{...}}; this mapping
// from cats.* to Consent Mode v2 must stay identical to the one in the banner script,
// otherwise a returning visitor silently gets a different state than the one they gave.
// The flat v1 shape is still read so older cookies keep working.
const cookieName = 'ccb_consent';
const cookieValues = getCookieValues(cookieName);
if (cookieValues && cookieValues.length > 0) {
  const raw = cookieValues[0];
  const parsed = JSON.parse(raw);
  if (parsed) {
    let consent;
    if (parsed.cats) {
      const cats = parsed.cats;
      const adState = cats.marketing === true ? 'granted' : 'denied';
      const anState = cats.analytics === true ? 'granted' : 'denied';
      const fnState = cats.functional === true ? 'granted' : 'denied';
      consent = {
        ad_storage: adState,
        ad_user_data: adState,
        ad_personalization: adState,
        analytics_storage: anState,
        functionality_storage: fnState,
        personalization_storage: fnState,
        security_storage: 'granted'
      };
    } else {
      consent = {
        ad_storage: parsed.ad_storage || 'denied',
        ad_user_data: parsed.ad_user_data || 'denied',
        ad_personalization: parsed.ad_personalization || 'denied',
        analytics_storage: parsed.analytics_storage || 'denied',
        functionality_storage: parsed.functionality_storage || 'denied',
        personalization_storage: parsed.personalization_storage || 'denied',
        security_storage: 'granted'
      };
    }
    updateConsentState(consent);
    log('GA4 Support Cookie Banner: restored an earlier choice from cookie ' + cookieName);
  }
}

setInWindow('__sst_cb_consent_sink', function (signalen) {
  updateConsentState(signalen);
}, true);

// Load the banner UI.
injectScript(
  bannerUrl,
  function() {
    log('GA4 Support Cookie Banner: loaded the banner script from ' + bannerUrl);
    data.gtmOnSuccess();
  },
  function() {
    log('GA4 Support Cookie Banner: could not load the banner script');
    data.gtmOnFailure();
  },
  'sst-cookie-banner'
);


