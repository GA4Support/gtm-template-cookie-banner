    assertApi('getCookieValues').wasCalledWith('ccb_consent');
- name: The banner script is injected
  code: |-
    const mockData = {
      klantId: 'aB3dEf7h',
      waitForUpdate: true,
      urlPassthrough: false,
      adsDataRedaction: false
    };
    runCode(mockData);
    assertApi('injectScript').wasCalled();
- name: The injected URL carries the account ID
  code: |-
    const mockData = {
      klantId: 'aB3dEf7h',
      waitForUpdate: true,
      urlPassthrough: false,
      adsDataRedaction: false
    };
    let injected;
    mock('injectScript', function (url) {
      injected = url;
    });
    runCode(mockData);
    assertThat(injected).isEqualTo('https://dashboard.ga4support.nl/api/cookie-banner/cb.js?klant=aB3dEf7h');
- name: An account ID with unsafe characters cannot escape the query string
  code: |-
    const mockData = {
      klantId: 'a/b?c',
      waitForUpdate: true
    };
    let injected;
    mock('injectScript', function (url) {
      injected = url;
    });
    runCode(mockData);
    assertThat(injected).isEqualTo('https://dashboard.ga4support.nl/api/cookie-banner/cb.js?klant=a%2Fb%3Fc');
- name: A stored choice of marketing yes maps to all three ad signals granted
